/* autumn.tcss
 * Textual CSS for the `autumn` GEPA dashboard.
 * Torlink-inspired layout (rounded box-drawn panels with embedded titles,
 * dimmed secondary text), recolored into a warm fall palette: soft earth
 * tones and ambers over a dark umber background.
 * Palette values here must stay in sync with autumn/palette.py.
 */

/* ============================== */
/* Layout & background            */
/* ============================== */

Screen {
    background: #241a12;
    color: #a9906f;
}

/* ============================== */
/* Panels & borders                */
/* ============================== */

#sidebar,
#agents-panel,
OverviewPane,
CandidatesTable,
LogView,
ModelCatalogView,
SettingsView,
TabbedContent {
    border: round #a9906f;
    border-title-align: left;
    border-title-color: #d98e4a;
}

#sidebar:focus,
#sidebar:focus-within,
#agents-panel:focus,
#agents-panel:focus-within,
OverviewPane:focus,
OverviewPane:focus-within,
CandidatesTable:focus,
CandidatesTable:focus-within,
LogView:focus,
LogView:focus-within,
ModelCatalogView:focus,
ModelCatalogView:focus-within,
SettingsView:focus,
SettingsView:focus-within,
TabbedContent:focus,
TabbedContent:focus-within {
    border: round #d98e4a;
}

/* ============================== */
/* Sidebar & run status            */
/* ============================== */

RunListItem {
    color: #c2a880;
    text-opacity: 55%;
}

RunListItem.-highlighted,
RunListItem:focus {
    color: #d98e4a;
    text-opacity: 100%;
    text-style: bold;
}

RunListItem.status-running {
    color: #e0a94f;
}

RunListItem.status-completed {
    color: #8faa5a;
}

RunListItem.status-failed {
    color: #c1542e;
}

RunListItem.status-stopped {
    color: #b5c98c;
}

/* ============================== */
/* Key hints & status utilities    */
/* ============================== */

.key-hint {
    color: #f0c17a;
    text-style: bold;
}

.status-error {
    color: #c1542e;
}

.status-warning {
    color: #e0a94f;
}

.status-success {
    color: #8faa5a;
}

/* ============================== */
/* Modals                          */
/* ============================== */

HelpScreen,
ConfirmScreen,
CandidateDetailScreen {
    background: #241a12 80%;
    align: center middle;
}

HelpScreen > Vertical,
ConfirmScreen > Vertical,
CandidateDetailScreen > VerticalScroll {
    border: round #d98e4a;
    border-title-color: #d98e4a;
    background: #241a12;
}

/* ============================== */
/* Progress bar                    */
/* ============================== */

ProgressBar > .bar--bar {
    color: #d98e4a;
}

ProgressBar > .bar--complete {
    color: #d98e4a;
}

ProgressBar > .bar--indeterminate {
    color: #d98e4a;
}
